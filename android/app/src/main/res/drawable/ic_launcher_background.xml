<?xml version="1.0" encoding="utf-8"?>
<!-- The accent gradient from the in-app wordmark: amber falling to a dimmer
     amber on the diagonal. Angle 315 runs top-left to bottom-right. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#A07A42"
        android:startColor="#F0B45C"
        android:type="linear" />
</shape>
